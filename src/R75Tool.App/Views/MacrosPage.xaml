<Page
    x:Class="R75Tool.App.Views.MacrosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:R75Tool.App.Controls"
    Title="Macros">

    <StackPanel Margin="24,8,24,24">
        <ui:TextBlock Text="Macros" FontTypography="Title" />
        <ui:TextBlock Margin="0,4,0,12" TextWrapping="Wrap"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="Una macro escribe un texto o pulsa varias teclas seguidas. Se guardan en el teclado, así que funcionan en cualquier PC. Para usarla, asígnala a una tecla en «Asignación de teclas» (categoría Macros)." />

        <ui:InfoBar x:Name="StatusInfo" Margin="0,0,0,12" IsClosable="True" />

        <Grid x:Name="ContentPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Lista de macros ============ -->
            <ui:Card Padding="4" VerticalAlignment="Top" Margin="0,0,12,0">
                <ListBox x:Name="MacroList" SelectionChanged="MacroList_SelectionChanged" />
            </ui:Card>

            <!-- ============ Editor ============ -->
            <StackPanel Grid.Column="1">
                <Grid Margin="0,0,0,8">
                    <StackPanel>
                        <ui:TextBlock x:Name="MacroTitle" FontTypography="Subtitle" />
                        <ui:TextBlock x:Name="UsageText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Content="Vaciar" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Icon="{ui:SymbolIcon Delete24}" Click="ClearButton_Click" />
                </Grid>

                <!-- Pasos de la macro (se crean desde el código) -->
                <StackPanel x:Name="StepsPanel" />
                <ui:TextBlock x:Name="EmptyText" Margin="0,4,0,8" Text="Esta macro está vacía. Añade un paso:"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- Añadir pasos -->
                <WrapPanel Margin="0,4,0,8">
                    <ui:Button Content="Texto" Icon="{ui:SymbolIcon TextT24}" Margin="0,0,6,0" Click="AddText_Click" />
                    <ui:Button x:Name="AddKeyButton" Content="Tecla o atajo" Icon="{ui:SymbolIcon Keyboard24}"
                               Margin="0,0,6,0" Click="AddKey_Click" />
                    <ui:Button Content="Pausa" Icon="{ui:SymbolIcon Timer24}" Click="AddDelay_Click" />
                </WrapPanel>

                <!-- Panel para elegir tecla (oculto hasta pulsar "Tecla o atajo") -->
                <ui:Card x:Name="KeyPanel" Visibility="Collapsed" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <ui:TextBlock Text="Marca los modificadores (si quieres un atajo) y pulsa la tecla:" Margin="0,0,0,8" />
                        <WrapPanel x:Name="ModsPanel" Margin="0,0,0,8" />
                        <controls:KeycodePicker x:Name="Picker" Height="220" KeycodeChosen="Picker_KeycodeChosen" />
                    </StackPanel>
                </ui:Card>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button x:Name="SaveButton" Content="Guardar en el teclado" Appearance="Primary"
                               Icon="{ui:SymbolIcon Save24}" Click="SaveButton_Click" />
                    <ui:Button x:Name="DiscardButton" Content="Descartar cambios" Margin="8,0,0,0"
                               Icon="{ui:SymbolIcon ArrowUndo24}" Click="DiscardButton_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>
</Page>
