<Page
    x:Class="R75Tool.App.Views.KnobPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:R75Tool.App.Controls"
    Title="Rueda de volumen">

    <Page.Resources>
        <!-- Las tres "fichas" (izquierda / derecha / pulsar) son RadioButtons con aspecto de botón -->
        <Style x:Key="SlotStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="GroupName" Value="slots" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="24,8,24,24">
        <ui:TextBlock Text="Rueda de volumen" FontTypography="Title" />
        <ui:TextBlock Margin="0,4,0,12" TextWrapping="Wrap"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="Elige qué hace la rueda al girarla y al pulsarla. Cada capa puede tener su propia función y el teclado guarda los cambios al momento." />

        <ui:InfoBar x:Name="StatusInfo" Margin="0,0,0,12" IsClosable="True" />

        <!-- ============ Volumen por aplicación (no depende de que el teclado esté conectado) ============ -->
        <!-- Tarjeta normal (no desplegable): así el clic va siempre al interruptor -->
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon AppFolder24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="La rueda cambia el volumen del programa activo" FontTypography="BodyStrong" />
                    <ui:TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="Por ejemplo, baja solo el juego sin tocar Discord. Si el programa no tiene sonido, la rueda cambia el volumen general." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="PerAppSwitch" Checked="PerAppSwitch_Changed" Unchecked="PerAppSwitch_Changed" />
        </ui:CardControl>
        <ui:Card x:Name="PerAppCard" Margin="0,0,0,12" Padding="16,12">
            <StackPanel x:Name="PerAppOptions">
                <!-- Qué ha hecho la rueda la última vez (para saber si funciona) -->
                <Border CornerRadius="6" Padding="10,6" Margin="0,0,0,10" Background="#20FFFFFF">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Info24" Margin="0,0,8,0" />
                        <ui:TextBlock x:Name="PerAppStatus" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:TextBlock Text="Cada paso de la rueda:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="StepCombo" Width="90" SelectionChanged="PerAppOption_Changed">
                        <ComboBoxItem Content="1 %" Tag="1" />
                        <ComboBoxItem Content="2 %" Tag="2" />
                        <ComboBoxItem Content="5 %" Tag="5" />
                        <ComboBoxItem Content="10 %" Tag="10" />
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="MuteCheck" Content="Pulsar la rueda silencia solo el programa activo" Margin="0,0,0,4" Click="PerAppOption_Changed" />
                <CheckBox x:Name="OsdCheck" Content="Mostrar un indicador con el programa y su volumen" Margin="0,0,0,8" Click="PerAppOption_Changed" />
                <ui:TextBlock x:Name="PerAppHint" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Text="Funciona mientras R75 Tool está abierta: al activarlo, cerrar la ventana la deja en la bandeja (junto al reloj) en vez de salir. Usa las teclas Vol+/Vol−/Mute, que son las que tiene la rueda de fábrica. En juegos en pantalla completa exclusiva el indicador puede no verse, pero el volumen cambia igual." />
            </StackPanel>
        </ui:Card>

        <StackPanel x:Name="ContentPanel">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ui:TextBlock Text="Capa" VerticalAlignment="Center" Margin="0,0,12,0" FontTypography="BodyStrong" />
                <StackPanel x:Name="LayerPanel" Orientation="Horizontal" />
            </StackPanel>

            <!-- ============ Atajos ============ -->
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Flash24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Configuraciones rápidas" FontTypography="BodyStrong" />
                        <ui:TextBlock Text="Cambia las tres acciones de golpe en esta capa"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <WrapPanel x:Name="PresetPanel" />
            </ui:CardControl>

            <!-- ============ Las tres acciones ============ -->
            <UniformGrid Columns="3" Margin="0,0,-8,8">
                <RadioButton x:Name="LeftSlot" Style="{StaticResource SlotStyle}" Checked="Slot_Checked">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowRotateCounterclockwise24" Margin="0,0,8,0" />
                            <ui:TextBlock Text="Girar a la izquierda" FontTypography="BodyStrong" />
                        </StackPanel>
                        <ui:TextBlock x:Name="LeftLabel" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <ui:TextBlock x:Name="LeftDesc" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="RightSlot" Style="{StaticResource SlotStyle}" Checked="Slot_Checked">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowRotateClockwise24" Margin="0,0,8,0" />
                            <ui:TextBlock Text="Girar a la derecha" FontTypography="BodyStrong" />
                        </StackPanel>
                        <ui:TextBlock x:Name="RightLabel" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <ui:TextBlock x:Name="RightDesc" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="PressSlot" Style="{StaticResource SlotStyle}" Checked="Slot_Checked">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CursorClick24" Margin="0,0,8,0" />
                            <ui:TextBlock Text="Pulsar" FontTypography="BodyStrong" />
                        </StackPanel>
                        <ui:TextBlock x:Name="PressLabel" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <ui:TextBlock x:Name="PressDesc" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <!-- ============ Selector ============ -->
            <Grid Margin="0,4,0,8">
                <ui:TextBlock x:Name="PickerTitle" FontTypography="BodyStrong" VerticalAlignment="Center" />
                <ui:Button x:Name="UndoButton" Content="Deshacer" HorizontalAlignment="Right" IsEnabled="False"
                           Icon="{ui:SymbolIcon ArrowUndo24}" Click="UndoButton_Click" />
            </Grid>
            <ui:Card Padding="0">
                <controls:KeycodePicker x:Name="Picker" Height="260" KeycodeChosen="Picker_KeycodeChosen" />
            </ui:Card>
        </StackPanel>
    </StackPanel>
</Page>
