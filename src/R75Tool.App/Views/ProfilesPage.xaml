<Page
    x:Class="R75Tool.App.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:R75Tool.App.Controls"
    Title="Perfiles por programa">

    <StackPanel Margin="24,8,24,24">
        <ui:TextBlock Text="Perfiles por programa" FontTypography="Title" />
        <ui:TextBlock Margin="0,4,0,12" TextWrapping="Wrap"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="Cambia la iluminación según el programa que estés usando. Los cambios no se guardan en el teclado (no lo desgastan) y solo funcionan mientras R75 Tool está abierta." />

        <ui:InfoBar x:Name="StatusInfo" Margin="0,0,0,12" IsClosable="True" />

        <!-- ============ Activar ============ -->
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon AppFolder24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="Activar perfiles" FontTypography="BodyStrong" />
                    <ui:TextBlock x:Name="ForegroundText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="EnabledSwitch" Click="EnabledSwitch_Click" />
        </ui:CardControl>

        <ui:InfoBar x:Name="TrayHint" Margin="0,0,0,12" IsClosable="True" Severity="Informational"
                    Title="Consejo"
                    Message="Activa «Al cerrar, seguir en la bandeja» en Ajustes para que los perfiles sigan funcionando con la ventana cerrada." />

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Lista ============ -->
            <StackPanel Margin="0,0,12,0">
                <ui:Card Padding="4">
                    <ListBox x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged" />
                </ui:Card>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Content="Añadir" Icon="{ui:SymbolIcon Add24}" Click="AddButton_Click" />
                    <ui:Button x:Name="DeleteButton" Content="Eliminar" Margin="6,0,0,0"
                               Icon="{ui:SymbolIcon Delete24}" Click="DeleteButton_Click" />
                </StackPanel>
            </StackPanel>

            <!-- ============ Editor ============ -->
            <ui:Card Grid.Column="1" Padding="16" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel x:Name="ProgramFields">
                        <ui:TextBlock Text="Nombre" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="NameBox" Margin="0,0,0,12" TextChanged="NameBox_TextChanged" />

                        <ui:TextBlock Text="Programa (nombre del .exe)" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ProcessBox" IsEditable="True"
                                      ToolTip="Escribe el nombre o elige uno de los programas abiertos"
                                      DropDownOpened="ProcessBox_DropDownOpened" LostFocus="ProcessBox_Changed"
                                      SelectionChanged="ProcessBox_Changed" />
                            <ui:Button Grid.Column="1" Content="Examinar…" Margin="6,0,0,0"
                                       Icon="{ui:SymbolIcon FolderOpen24}" Click="BrowseButton_Click" />
                        </Grid>

                        <CheckBox x:Name="ActiveCheck" Content="Perfil activo" Margin="0,0,0,12" Click="ActiveCheck_Click" />
                    </StackPanel>
                    <ui:TextBlock x:Name="DefaultHint" TextWrapping="Wrap" Margin="0,0,0,12"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="Esta iluminación se usa en todos los programas que no tienen su propio perfil." />

                    <ui:TextBlock Text="Iluminación" FontTypography="BodyStrong" Margin="0,0,0,8" />
                    <controls:LightingEditor x:Name="Editor" StateChanged="Editor_StateChanged" />

                    <WrapPanel Margin="0,12,0,0">
                        <ui:Button Content="Copiar la iluminación actual del teclado" Margin="0,0,6,6"
                                   Icon="{ui:SymbolIcon ArrowDownload24}" Click="CopyCurrentButton_Click" />
                        <ui:Button Content="Probar en el teclado" Margin="0,0,6,6"
                                   Icon="{ui:SymbolIcon Play24}" Click="TryButton_Click" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>
        </Grid>
    </StackPanel>
</Page>
