<Page
    x:Class="R75Tool.App.Views.LightingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Iluminación RGB">

    <StackPanel Margin="24,8,24,24">
        <ui:TextBlock Text="Iluminación RGB" FontTypography="Title" />
        <ui:TextBlock Margin="0,4,0,16" TextWrapping="Wrap"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="Los cambios se aplican al momento. Pulsa «Guardar en el teclado» para que se mantengan al desconectarlo." />

        <ui:InfoBar x:Name="StatusInfo" Margin="0,0,0,12" IsClosable="True" />

        <StackPanel x:Name="ControlsPanel">
            <!-- ============ Efecto ============ -->
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Flash24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Efecto" FontTypography="BodyStrong" />
                        <ui:TextBlock Text="Animación de las luces"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="EffectCombo" MinWidth="260" DisplayMemberPath="Name"
                          SelectionChanged="EffectCombo_SelectionChanged" />
            </ui:CardControl>

            <!-- ============ Brillo ============ -->
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon BrightnessHigh24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Brillo" FontTypography="BodyStrong" />
                        <ui:TextBlock Text="Intensidad de los LED"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock x:Name="BrightnessLabel" Width="48" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0" />
                    <Slider x:Name="BrightnessSlider" Width="300" Minimum="0" Maximum="255" VerticalAlignment="Center"
                            ValueChanged="BrightnessSlider_ValueChanged" />
                </StackPanel>
            </ui:CardControl>

            <!-- ============ Velocidad ============ -->
            <ui:CardControl x:Name="SpeedCard" Margin="0,0,0,4" Icon="{ui:SymbolIcon TopSpeed24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Velocidad" FontTypography="BodyStrong" />
                        <ui:TextBlock Text="Rapidez de la animación"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock x:Name="SpeedLabel" Width="48" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0" />
                    <Slider x:Name="SpeedSlider" Width="300" Minimum="0" Maximum="255" VerticalAlignment="Center"
                            ValueChanged="SpeedSlider_ValueChanged" />
                </StackPanel>
            </ui:CardControl>

            <!-- ============ Color ============ -->
            <ui:Card x:Name="ColorCard" Margin="0,0,0,12" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:SymbolIcon Symbol="Color24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <ui:TextBlock Text="Color" FontTypography="BodyStrong" />
                        <ui:TextBlock x:Name="ColorHint" Text="Tono y saturación (el brillo se ajusta arriba)"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border x:Name="ColorPreview" Grid.Column="2" Grid.RowSpan="2" Width="44" Height="44"
                            CornerRadius="22" BorderBrush="#40FFFFFF" BorderThickness="1" VerticalAlignment="Top" />

                    <!-- Colores rápidos: se rellenan desde el código -->
                    <WrapPanel x:Name="PresetPanel" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" />

                    <!-- Tono: barra arcoíris debajo del slider para ver qué color es cada posición -->
                    <ui:TextBlock Grid.Row="2" Grid.Column="0" Text="Tono" VerticalAlignment="Center" Margin="0,16,16,0" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,16,0,0">
                        <Slider x:Name="HueSlider" Minimum="0" Maximum="255" ValueChanged="ColorSlider_ValueChanged" />
                        <Border x:Name="HueBar" Height="6" CornerRadius="3" Margin="8,2,8,0" />
                    </StackPanel>

                    <ui:TextBlock Grid.Row="3" Grid.Column="0" Text="Saturación" VerticalAlignment="Center" Margin="0,12,16,0" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,12,0,0">
                        <Slider x:Name="SatSlider" Minimum="0" Maximum="255" ValueChanged="ColorSlider_ValueChanged" />
                        <Border x:Name="SatBar" Height="6" CornerRadius="3" Margin="8,2,8,0" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- ============ Acciones ============ -->
            <StackPanel Orientation="Horizontal">
                <ui:Button x:Name="SaveButton" Content="Guardar en el teclado" Appearance="Primary"
                           Icon="{ui:SymbolIcon Save24}" Click="SaveButton_Click" />
                <ui:Button Content="Volver a leer" Margin="8,0,0,0"
                           Icon="{ui:SymbolIcon ArrowClockwise24}" Click="ReloadButton_Click" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Page>
