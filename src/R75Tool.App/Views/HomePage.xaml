<Page
    x:Class="R75Tool.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Inicio">

    <StackPanel Margin="24,8,24,24">
        <ui:TextBlock Text="Inicio" FontTypography="Title" />
        <ui:TextBlock Margin="0,4,0,16" TextWrapping="Wrap"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="Resumen del teclado conectado. Usa el menú de la izquierda para configurarlo." />

        <ui:InfoBar x:Name="DisconnectedInfo" Title="No se encuentra el teclado" IsClosable="False"
                    Severity="Warning" Margin="0,0,0,12"
                    Message="Conéctalo por cable (interruptor en modo USB) y cierra el software oficial de Royal Kludge si está abierto. La app lo detectará sola." />

        <!-- ============ Estado ============ -->
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon PlugConnected24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="Estado" FontTypography="BodyStrong" />
                    <ui:TextBlock x:Name="StateText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBlock x:Name="StateBadge" FontTypography="BodyStrong" />
        </ui:CardControl>

        <!-- ============ Datos del dispositivo ============ -->
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Info24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="Dispositivo" FontTypography="BodyStrong" />
                    <ui:TextBlock Text="Datos que devuelve el teclado por el protocolo VIA"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:CardControl.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <ui:TextBlock Text="VID / PID" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="Protocolo VIA" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="Capas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="Definición" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock Text="Distribución" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <ui:TextBlock x:Name="IdsText" Text="—" />
                    <ui:TextBlock x:Name="ProtocolText" Text="—" />
                    <ui:TextBlock x:Name="LayersText" Text="—" />
                    <ui:TextBlock x:Name="DefinitionText" Text="—" />
                    <ui:TextBlock x:Name="LayoutText" Text="—" />
                </StackPanel>
            </Grid>
        </ui:CardControl>

        <!-- ============ Iluminación actual (con acceso directo) ============ -->
        <ui:CardAction x:Name="LightingCard" Margin="0,0,0,4" Icon="{ui:SymbolIcon Lightbulb24}"
                       Click="LightingCard_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <ui:TextBlock Text="Iluminación" FontTypography="BodyStrong" />
                    <ui:TextBlock x:Name="LightingText" Text="—"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border x:Name="LightingSwatch" Grid.Column="1" Width="28" Height="28" CornerRadius="14"
                        Margin="0,0,8,0" BorderBrush="#40FFFFFF" BorderThickness="1" />
            </Grid>
        </ui:CardAction>
    </StackPanel>
</Page>
