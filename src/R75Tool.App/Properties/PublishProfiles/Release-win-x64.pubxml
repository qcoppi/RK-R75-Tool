<?xml version="1.0" encoding="utf-8"?>
<!--
  Perfil para la Release de GitHub: un único R75Tool.exe que lleva .NET dentro
  (quien lo descargue no tiene que instalar nada).

  Desde la terminal:   dotnet publish src/R75Tool.App -p:PublishProfile=Release-win-x64
  Desde Visual Studio: clic derecho en R75Tool.App → Publicar → este perfil.
  Resultado: carpeta publish/ en la raíz del repositorio (ignorada por git).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Las DLL nativas de WPF y los JSON de Assets van también dentro del .exe -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
