<UserControl
    x:Class="R75Tool.App.Controls.LightingEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Editor de una iluminación completa (sin enviar nada al teclado: eso lo decide quien lo use) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TextBlock Text="Efecto" VerticalAlignment="Center" />
        <ComboBox x:Name="EffectCombo" Grid.Column="1" DisplayMemberPath="Name" Margin="0,0,0,8"
                  SelectionChanged="Any_Changed" />
        <Border x:Name="Preview" Grid.Column="2" Grid.RowSpan="2" Width="44" Height="44" CornerRadius="22"
                Margin="16,0,0,0" BorderBrush="#40FFFFFF" BorderThickness="1" VerticalAlignment="Top" />

        <ui:TextBlock Grid.Row="1" Text="Brillo" VerticalAlignment="Center" />
        <Slider x:Name="BrightnessSlider" Grid.Row="1" Grid.Column="1" Maximum="255" Margin="0,4" ValueChanged="Any_Changed" />

        <ui:TextBlock Grid.Row="2" Text="Velocidad" VerticalAlignment="Center" />
        <Slider x:Name="SpeedSlider" Grid.Row="2" Grid.Column="1" Maximum="255" Margin="0,4" ValueChanged="Any_Changed" />

        <ui:TextBlock Grid.Row="3" Text="Tono" VerticalAlignment="Center" />
        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,4">
            <Slider x:Name="HueSlider" Maximum="255" ValueChanged="Any_Changed" />
            <Border x:Name="HueBar" Height="6" CornerRadius="3" Margin="8,2,8,0" />
        </StackPanel>

        <ui:TextBlock Grid.Row="4" Text="Saturación" VerticalAlignment="Center" />
        <Slider x:Name="SatSlider" Grid.Row="4" Grid.Column="1" Maximum="255" Margin="0,4" ValueChanged="Any_Changed" />
    </Grid>
</UserControl>
