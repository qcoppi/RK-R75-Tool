<UserControl
    x:Class="R75Tool.App.Controls.KeycodePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Selector de keycodes: categorías a la izquierda y botones a la derecha.
         Lo usan "Asignación de teclas" y "Rueda de volumen". -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="CategoryList" Margin="8" DisplayMemberPath="Key"
                 SelectionChanged="CategoryList_SelectionChanged" />
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,8,8,8">
            <WrapPanel x:Name="KeycodePanel" />
        </ScrollViewer>
    </Grid>
</UserControl>
