<Window
    x:Class="R75Tool.App.Audio.VolumeOsd"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
    SizeToContent="WidthAndHeight" Focusable="False" IsHitTestVisible="False">
    <!-- Indicador de volumen por aplicación (como el de Windows, pero con el nombre del programa) -->
    <Border CornerRadius="10" Padding="16,12" Margin="12" Width="300"
            Background="#F02B2B2B" BorderBrush="#30FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:SymbolIcon x:Name="VolumeIcon" Grid.RowSpan="2" Symbol="Speaker224" FontSize="24"
                           Foreground="White" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock x:Name="AppName" Grid.Column="1" Foreground="White" FontSize="13" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="Percent" Grid.Column="2" Foreground="White" FontSize="13" Margin="8,0,0,0" />
            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="4" Margin="0,8,0,0">
                <Border Background="#40FFFFFF" CornerRadius="2" />
                <Border x:Name="Bar" Background="#60CDFF" CornerRadius="2" HorizontalAlignment="Left" />
            </Grid>
        </Grid>
    </Border>
</Window>
