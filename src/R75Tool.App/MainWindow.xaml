<ui:FluentWindow
    x:Class="R75Tool.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:R75Tool.App.Controls"
    xmlns:views="clr-namespace:R75Tool.App.Views"
    Title="R75 Tool"
    Icon="pack://application:,,,/R75Tool;component/Assets/app.ico"
    Width="1240" Height="900" MinWidth="960" MinHeight="680"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- barra de título -->
            <RowDefinition Height="Auto" /> <!-- cabecera con el teclado -->
            <RowDefinition Height="*" />    <!-- menú + página -->
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="R75 Tool">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/R75Tool;component/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ===================== Cabecera: teclado detectado + dibujo ===================== -->
        <Border Grid.Row="1" Margin="16,4,16,8" Padding="24,16" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <ui:TextBlock Text="Teclado" FontTypography="Caption"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBlock x:Name="KeyboardName" Text="Royal Kludge R75" FontTypography="Subtitle"
                                  TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" />
                        <ui:TextBlock x:Name="StatusText" Text="Buscando teclado…" Margin="8,0,0,0" />
                    </StackPanel>
                    <ui:TextBlock x:Name="StatusDetail" Margin="18,2,0,0" FontTypography="Caption" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <controls:KeyboardView x:Name="KeyboardPreview" Grid.Column="1" Height="200" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <!-- ===================== Menú lateral + páginas ===================== -->
        <ui:NavigationView x:Name="RootNavigation" Grid.Row="2"
                           PaneDisplayMode="Left" OpenPaneLength="240"
                           IsBackButtonVisible="Collapsed" IsPaneToggleVisible="True">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Inicio" TargetPageType="{x:Type views:HomePage}"
                                       Icon="{ui:SymbolIcon Home24}" />
                <ui:NavigationViewItem Content="Iluminación RGB" TargetPageType="{x:Type views:LightingPage}"
                                       Icon="{ui:SymbolIcon Lightbulb24}" />
                <ui:NavigationViewItem Content="Perfiles por programa" TargetPageType="{x:Type views:ProfilesPage}"
                                       Icon="{ui:SymbolIcon Apps24}" />
                <ui:NavigationViewItem Content="Macros" TargetPageType="{x:Type views:MacrosPage}"
                                       Icon="{ui:SymbolIcon Record24}" />
                <ui:NavigationViewItem Content="Rueda de volumen" TargetPageType="{x:Type views:KnobPage}"
                                       Icon="{ui:SymbolIcon Speaker224}" />
                <!-- Al final: se usa poco (sobre todo para asignar macros o arreglar el teclado) -->
                <ui:NavigationViewItem Content="Asignación de teclas" TargetPageType="{x:Type views:KeymapPage}"
                                       Icon="{ui:SymbolIcon Keyboard24}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Ajustes" TargetPageType="{x:Type views:SettingsPage}"
                                       Icon="{ui:SymbolIcon Settings24}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
